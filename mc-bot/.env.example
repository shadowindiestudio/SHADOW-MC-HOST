# Discord application credentials. Keep the real values in .env only.
TOKEN=your-discord-bot-token
CLIENT_ID=your-discord-application-id
GUILD_ID=your-discord-guild-id

# The bot controls the single configured server for now.
SERVER_PATH=../
SERVER_JAR=server.jar
JAVA_PATH=java

# RCON settings are read from ../server.properties. These optional values are
# only compatibility fallbacks for older/private setups.
# RCON_HOST=127.0.0.1
# RCON_PORT=25575
# RCON_PASSWORD=change-this-local-password