{
  "name": "SHADOW-MC-HOST",
  "version": "1.0.0",
  "description": "Desktop manager for SHADOW MC HOST - Minecraft Server Manager with Discord Bot",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win --x64",
    "dist": "electron-builder",
    "package:win": "electron-packager . \"Shadow MC Host\" --platform=win32 --arch=x64 --out=dist --overwrite --asar=false"
  },
  "build": {
    "appId": "com.shadowmc.host",
    "productName": "Shadow MC Host",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "pidusage": "^4.0.1",
    "rcon-client": "^4.2.5"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  }
}
